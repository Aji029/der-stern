# Same Supabase project as der Stern — the articles live in public.products there.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# The ANTHROPIC_API_KEY is NOT set here. It belongs to the edge function only:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Anything in a VITE_ variable is shipped to the browser in plain text.
